import "src/r6-dissect.atlas";
import "std/io";
import "std/string";

#[c_name("putchar")]
private extern "C" fun putchar(c: int32) -> int32;

private fun print_repeated(ch: int32, count: int32) {
    let i: int32 = 0;
    while i < count {
        putchar(ch);
        i = i + 1;
    }
}

// Column widths below (16, 8, 8, 8, 8, 8, 7, 7, 6, 9, 8) must stay in sync
// between print_row_separator and every printf field width in
// print_leaderboard -- change one, change both, or the borders won't line
// up with the content. table_width is their sum plus one '+' per column
// plus the leading '+', used for the title block's own border.
private fun table_width() -> int32 {
    return 18 + 18 + 18 + 9 + 8 + 8 + 7 + 10 + 9;
}

private fun print_row_separator() {
    std::print("+");
    print_repeated('-' as int32, 16);
    std::print("+");
    print_repeated('-' as int32, 8);
    std::print("+");
    print_repeated('-' as int32, 8);
    std::print("+");
    print_repeated('-' as int32, 8);
    std::print("+");
    print_repeated('-' as int32, 8);
    std::print("+");
    print_repeated('-' as int32, 8);
    std::print("+");
    print_repeated('-' as int32, 7);
    std::print("+");
    print_repeated('-' as int32, 7);
    std::print("+");
    print_repeated('-' as int32, 6);
    std::print("+");
    print_repeated('-' as int32, 9);
    std::print("+");
    print_repeated('-' as int32, 8);
    std::println("+");
}

private fun print_header_row() {
    std::printf("|%-16s", "Player");
    std::printf("|%8s", "K/D");
    std::printf("|%8s", "KPR");
    std::printf("|%8s", "HS%");
    std::printf("|%8s", "SRV");
    std::printf("|%8s", "KOST");
    std::printf("|%7s", "Entry");
    std::printf("|%7s", "Trade");
    std::printf("|%6s", "Obj");
    std::printf("|%9s", "Clutches");
    std::printf("|%8s|\n", "Rating");
}

fun print_leaderboard(match_: *const r6::Match, title: *const uint8) {
    let map_name = match_->map();
    let team0_name = match_->team_name(0);
    let team1_name = match_->team_name(1);
    let team0_score = match_->team_score(r6::TeamIndex::new(0));
    let team1_score = match_->team_score(r6::TeamIndex::new(1));
    let rounds = match_->round_count();

    std::printf("\n%s\n", title);
    print_repeated('=' as int32, table_width());
    std::println("");
    std::printf("Map: %s\n", map_name->c_str());
    std::printf("%s", team0_name->c_str());
    std::printf(" %d", team0_score);
    std::print(" vs ");
    std::printf("%s", team1_name->c_str());
    std::printf(" %d\n", team1_score);
    std::printf("Rounds played: %d\n", rounds);
    // No match timestamp is currently tracked (r6::Match has no time
    // field) -- Header.Timestamp exists upstream in r6-dissect if you want
    // to wire it through DissectHeader later.
    print_repeated('=' as int32, table_width());
    std::println("");

    print_row_separator();
    print_header_row();
    print_row_separator();

    let board = match_->get_leaderboard();
    let i: uint64 = 0;
    while i < board.len() {
        let s = board.get(i);
        std::printf("|%-16s", s->username.c_str());
        std::printf("|%8.2f", s->kd());
        std::printf("|%8.2f", s->kpr());
        std::printf("|%8.2f", s->hs_percent());
        std::printf("|%8.2f", s->srv());
        std::printf("|%8.2f", s->kost());
        std::printf("|%7d", s->entry());
        std::printf("|%7d", s->trade_diff());
        std::printf("|%6d", s->objective());
        std::printf("|%9d", s->clutches);
        std::printf("|%8.2f|\n", s->rating());

        i = i + 1;
    }
    print_row_separator();
}

fun main(argc: int32, argv: **char) -> int32 {
    std::println("R6 match stat builder");
    std::println("Enter the path to the first round replay file:");

    let match_result: std::optional<r6::Match> = std::optional<r6::Match>::empty();
    while match_result.is_empty() {
        std::print("> ");
        let path = std::input();
        match_result = dissect::open_match(&path);
        if match_result.is_empty() {
            std::println("Could not open/parse that file. Try again.");
        }
    }
    // Consumes match_result -- from here on `match_` is a plain, owned r6::Match.
    let match_ = match_result.value();

    std::println("Match initialized.");
    std::println("Enter another round file path, 'leaderboard', or 'done'.");

    let done_str = std::string::from_chars("done").trim();
    let leaderboard_str = std::string::from_chars("leaderboard").trim();

    let done: bool = false;
    while !done {
        std::print("> ");
        let line = std::input().trim();

        if line == done_str {
            done = true;
        } else if line == leaderboard_str {
            print_leaderboard(&match_, "Current standings");
        } else {
            let ok = dissect::load_round(&match_, &line);
            if ok {
                std::println("Round loaded.");
            } else {
                std::println("Could not open/parse that file.");
            }
        }
    }

    print_leaderboard(&match_, "Final leaderboard");

    return 0;
}

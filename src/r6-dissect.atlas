import "std/vector";
import "std/optional";
import "std/string";

import "src/events.atlas";
import "src/player.atlas";
import "src/round_stats.atlas";
import "src/round.atlas";
import "src/types.atlas";
import "src/match.atlas";

// --- C-layout structs mirroring r6_wrapper.go's cgo preamble ---
// Field order and widths must stay in lockstep with the Go side; nothing
// else enforces that. Every non-null pointer this library hands back must
// be released via the matching Free* function below, exactly once.

public extern struct DissectHeader {
  public:
    match_id: *uint8;
    map_name: *uint8;
    game_mode: *uint8;
    game_version: *uint8;
    site: *uint8;
    round_number: int32;
    rounds_per_match: int32;
}

public extern struct DissectTeam {
  public:
    name: *uint8;
    starting_score: int32;
    score: int32;
    won: int32;           // 0/1
    win_condition: *uint8; // "KilledOpponents"/"SecuredArea"/"DisabledDefuser"/
                           // "DefusedBomb"/"ExtractedHostage"/"Time"/"" if undecided
    role: *uint8;           // "Attack"/"Defense"
}

public extern struct DissectPlayer {
  public:
    username: *uint8;
    team_index: int32;
    operator_name: *uint8;
}

public extern struct DissectEvent {
  public:
    event_type: *uint8;
    username: *uint8;
    target: *uint8;
    headshot: int32;        // -1 = not applicable to this event type, else 0/1
    time_in_seconds: float64;
    operator_name: *uint8;
}

namespace dissect {
    #[c_name("Dissect_Open")]
    private extern "C" fun Open(filePath: *const uint8) -> uint64;
    #[c_name("Dissect_Free")]
    private extern "C" fun Free(h: uint64);

    #[c_name("Dissect_PlayerCount")]
    private extern "C" fun PlayerCount(h: uint64) -> int32;
    #[c_name("Dissect_EventCount")]
    private extern "C" fun EventCount(h: uint64) -> int32;

    #[c_name("Dissect_GetHeader")]
    private extern "C" fun GetHeader(h: uint64) -> *DissectHeader;
    #[c_name("Dissect_FreeHeader")]
    private extern "C" fun FreeHeader(header: *DissectHeader);

    #[c_name("Dissect_GetTeam")]
    private extern "C" fun GetTeam(h: uint64, index: int32) -> *DissectTeam;
    #[c_name("Dissect_FreeTeam")]
    private extern "C" fun FreeTeam(team: *DissectTeam);

    #[c_name("Dissect_GetPlayer")]
    private extern "C" fun GetPlayer(h: uint64, index: int32) -> *DissectPlayer;
    #[c_name("Dissect_FreePlayer")]
    private extern "C" fun FreePlayer(player: *DissectPlayer);

    #[c_name("Dissect_GetEvent")]
    private extern "C" fun GetEvent(h: uint64, index: int32) -> *DissectEvent;
    #[c_name("Dissect_FreeEvent")]
    private extern "C" fun FreeEvent(event: *DissectEvent);

    // ---- glue: dissect handle -> r6::Match / r6::Round ----
    //
    // Versus the old per-field-getter design, every still-open gap is
    // closed except weapon name, which the underlying r6-dissect library
    // (redraskal/r6-dissect, MatchUpdate struct) genuinely does not record
    // at all -- not a binding gap, there's nothing to bind. KillEvent.weapon
    // stays empty for anything loaded through here.
    //
    // Also unverified: the exact strings Dissect_GetEvent's event_type and
    // Dissect_GetTeam's win_condition/role fields carry ("Kill",
    // "DefuserPlantComplete", "DefuserDisableComplete", "KilledOpponents",
    // "SecuredArea", "DisabledDefuser", "DefusedBomb", "ExtractedHostage",
    // "Time", "Attack", "Defense" below) match the r6-dissect release you're
    // actually linking against. If kills/objectives/win conditions silently
    // don't show up, print the raw values for a few events/teams first.

    private fun parse_team_side(role: *const uint8) -> r6::TeamSide {
        let role_str = std::string::from_chars(role);
        if role_str == std::string::from_chars("Attack") {
            return r6::TeamSide::ATTACK;
        }
        if role_str == std::string::from_chars("Defense") {
            return r6::TeamSide::DEFENSE;
        }
        return r6::TeamSide::UNKNOWN_TEAM_SIDE;
    }

    private fun parse_win_condition(cond: *const uint8) -> r6::WinCondition {
        let cond_str = std::string::from_chars(cond);
        if cond_str == std::string::from_chars("KilledOpponents") {
            return r6::WinCondition::ELIMININATION;
        }
        if cond_str == std::string::from_chars("SecuredArea") {
            return r6::WinCondition::OBJECTIVE_SECURED;
        }
        if cond_str == std::string::from_chars("DisabledDefuser") {
            return r6::WinCondition::DEFUSER_DISABLED;
        }
        if cond_str == std::string::from_chars("DefusedBomb") {
            return r6::WinCondition::BOMB_DEFUSED;
        }
        if cond_str == std::string::from_chars("ExtractedHostage") {
            return r6::WinCondition::HOSTAGE_EXTRACTED;
        }
        if cond_str == std::string::from_chars("Time") {
            return r6::WinCondition::TIME_EXPIRED;
        }
        return r6::WinCondition::UNKNOWN_WIN_CON;
    }

    // Resolves (or registers) every player from the currently-open round's
    // header into `match_`'s roster, then builds and appends one r6::Round
    // from that round's participants, kill timeline, objective events, and
    // winner. Does not touch match_'s header fields (id/map/mode/version).
    private fun populate_round(match_: *r6::Match, handle: uint64) {
        let header = dissect::GetHeader(handle);
        let round_number: int32 = 0;
        let site = std::string::default();
        if header != null {
            round_number = header->round_number;
            site = std::string::from_chars(header->site);
            dissect::FreeHeader(header);
        }

        let round = match_->add_round(round_number, std::move(site));

        // Resolve each team's side once; every player on that team_index
        // shares it. Kept alive until win-condition handling at the end.
        let team0 = dissect::GetTeam(handle, 0);
        let team1 = dissect::GetTeam(handle, 1);
        let team0_side = r6::TeamSide::UNKNOWN_TEAM_SIDE;
        let team1_side = r6::TeamSide::UNKNOWN_TEAM_SIDE;
        if team0 != null {
            team0_side = dissect::parse_team_side(team0->role);
            match_->set_team(0, r6::Team::new(0, std::string::from_chars(team0->name)));
        } else {
            match_->set_team(0, r6::Team::new(0, std::string::from_chars("<null>")));
        }
        if team1 != null {
            team1_side = dissect::parse_team_side(team1->role);
            match_->set_team(1, r6::Team::new(1, std::string::from_chars(team1->name)));
        } else {
            match_->set_team(1, r6::Team::new(1, std::string::from_chars("<null>")));
        }

        let player_count = dissect::PlayerCount(handle);
        let i: int32 = 0;
        while i < player_count {
            let player = dissect::GetPlayer(handle, i);
            if player != null {
                let username = std::string::from_chars(player->username);
                let team_index = player->team_index;

                let existing = match_->find_player_by_username(&username);
                let player_id = r6::PlayerId::default();
                if existing != null {
                    player_id = existing->id;
                } else {
                    player_id = match_->add_player(username.copy(), team_index);
                }

                let side = r6::TeamSide::UNKNOWN_TEAM_SIDE;
                if team_index == 0 {
                    side = team0_side;
                } else if team_index == 1 {
                    side = team1_side;
                }

                round->add_participant(r6::RoundParticipant::new(
                    player_id,
                    r6::TeamIndex::new(team_index),
                    side,
                    std::string::from_chars(player->operator_name)
                ));

                dissect::FreePlayer(player);
            }
            i = i + 1;
        }

        let event_count = dissect::EventCount(handle);
        let kill_type = std::string::from_chars("Kill");
        let plant_type = std::string::from_chars("DefuserPlantComplete");
        let disable_type = std::string::from_chars("DefuserDisableComplete");

        i = 0;
        while i < event_count {
            let event = dissect::GetEvent(handle, i);
            if event != null {
                let type_str = std::string::from_chars(event->event_type);
                let time = event->time_in_seconds;

                if type_str == kill_type {
                    let killer_name = std::string::from_chars(event->username);
                    let victim_name = std::string::from_chars(event->target);

                    let killer_id = r6::PlayerId::default();
                    let killer_player = match_->find_player_by_username(&killer_name);
                    if killer_player != null {
                        killer_id = killer_player->id;
                    }

                    let victim_id = r6::PlayerId::default();
                    let victim_player = match_->find_player_by_username(&victim_name);
                    if victim_player != null {
                        victim_id = victim_player->id;
                    }

                    // -1 (not applicable) reads as "not a headshot" here;
                    // only genuine kills carry this field anyway.
                    let headshot = event->headshot == 1;

                    round->add_kill(r6::KillEvent::new(
                        time,
                        killer_id,
                        victim_id,
                        headshot,
                        std::optional<std::string>::empty()
                    ));
                } else if type_str == plant_type {
                    let username = std::string::from_chars(event->username);
                    let player = match_->find_player_by_username(&username);
                    if player != null {
                        round->add_objective_event(r6::ObjectiveEvent::new(
                            time, player->id, r6::ObjectiveActionType::PLANT_COMPLETE
                        ));
                    }
                } else if type_str == disable_type {
                    let username = std::string::from_chars(event->username);
                    let player = match_->find_player_by_username(&username);
                    if player != null {
                        round->add_objective_event(r6::ObjectiveEvent::new(
                            time, player->id, r6::ObjectiveActionType::DISABLE_COMPLETE
                        ));
                    }
                }

                dissect::FreeEvent(event);
            }
            i = i + 1;
        }

        let winning_team_index = -1;
        let win_condition = r6::WinCondition::UNKNOWN_WIN_CON;
        if team0 != null && team0->won == 1 {
            winning_team_index = 0;
            win_condition = dissect::parse_win_condition(team0->win_condition);
        } else if team1 != null && team1->won == 1 {
            winning_team_index = 1;
            win_condition = dissect::parse_win_condition(team1->win_condition);
        }
        round->set_winner(r6::TeamIndex::new(winning_team_index), win_condition);

        if team0 != null {
            dissect::FreeTeam(team0);
        }
        if team1 != null {
            dissect::FreeTeam(team1);
        }
    }

    //! Opens the first round file of a match: reads header info to
    //! construct a fresh r6::Match, then loads that round's data into it.
    //! Returns empty on failure to open/read the file.
    public fun open_match(path: *std::string) -> std::optional<r6::Match> {
        let c_path = path->c_str();
        // c_str() returns *const uint8; Dissect_Open wants a raw C string.
        // Adjust this cast if the compiler rejects it as written.
        let handle = dissect::Open(c_path);
        if handle == 0 {
            return std::optional<r6::Match>::empty();
        }

        let header = dissect::GetHeader(handle);
        let match_id = std::string::default();
        let map_name = std::string::default();
        let game_mode = std::string::default();
        let game_version = std::string::default();
        if header != null {
            match_id = std::string::from_chars(header->match_id);
            map_name = std::string::from_chars(header->map_name);
            game_mode = std::string::from_chars(header->game_mode);
            game_version = std::string::from_chars(header->game_version);
            dissect::FreeHeader(header);
        }
        let match_value = r6::Match::new(
            std::move(match_id),
            std::move(map_name),
            std::move(game_mode),
            std::move(game_version)
        );

        dissect::populate_round(&match_value, handle);
        dissect::Free(handle);

        return std::optional<r6::Match>::of(std::move(match_value));
    }

    //! Loads one more round file into an already-initialized match.
    //! Returns false (leaving match_ untouched) on failure to open/read.
    public fun load_round(match_: *r6::Match, path: *std::string) -> bool {
        let c_path = path->c_str();
        let handle = dissect::Open(c_path);
        if handle == 0 {
            return false;
        }

        dissect::populate_round(match_, handle);
        dissect::Free(handle);
        return true;
    }
}
